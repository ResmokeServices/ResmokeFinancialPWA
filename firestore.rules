rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User-isolated expenses subcollection
    match /users/{userId}/expenses/{expenseId} {
      // Only the authenticated owner can read, write, or delete their expenses
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Data schema validation helpers
      function isValidExpense() {
        let data = request.resource.data;
        return data.name is string && data.name.size() > 0
          && data.scope in ['personal', 'company']
          && data.dueDate is string
          && data.paymentMethod in ['Debit Order', 'EFT', 'Cash', 'Card', 'Cash Send']
          && data.monthlyDueConfig is map
          && data.monthlyDueDateConfig is map
          && data.payments is list;
      }

      allow create: if request.auth != null && request.auth.uid == userId && isValidExpense();
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
